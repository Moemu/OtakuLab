# Copy to .env for API-based stages. Do not commit credentials.
# Use an endpoint and model from the same provider.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_CHAT_MODEL=

# Notebook 31 uses this variable instead of OPENAI_CHAT_MODEL.
NEUTRAL_MODEL=

# HanLP REST tokenization and constituency parsing.
HANLP_API_KEY=

# Paper-aligned Baseline C in notebook 32; independent of other API stages.
BASELINE_C_MODEL=glm-4.7

# Optional checkpoint/model path overrides for notebook 32.
# SFT_CHECKPOINT=outputs/model/styled-qwen-v4.3-4e-05
# DPO_CHECKPOINT=outputs/model/styled-qwen-dpo-v1/checkpoint-150
# VANILLA_CHECKPOINT=outputs/evaluate/baseline/Vanilla
# QWEN_MODEL_PATH=../Models/Qwen3-1.7B
